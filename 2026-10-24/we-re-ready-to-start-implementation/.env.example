NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-server-only-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Phase 2 model registry. Set a tier to disabled if your project cannot access it.
GEMINI_MODEL_LOW=gemini-3.5-flash-lite
GEMINI_MODEL_MEDIUM=gemini-3.8-flash
GEMINI_MODEL_HIGH=gemini-4-argon
# Optional: one registered model to try after a definite 404/429/503 rejection.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Pricing is intentionally unset. Supply current USD/1M token rates for your plan.
# Set 0 only if that model is genuinely free on your plan.
GEMINI_LOW_INPUT_USD_PER_MILLION=
GEMINI_LOW_OUTPUT_USD_PER_MILLION=
GEMINI_MEDIUM_INPUT_USD_PER_MILLION=
GEMINI_MEDIUM_OUTPUT_USD_PER_MILLION=
GEMINI_HIGH_INPUT_USD_PER_MILLION=
GEMINI_HIGH_OUTPUT_USD_PER_MILLION=
# Optional reference model; defaults to the highest configured tier.
AI_BASELINE_MODEL=
